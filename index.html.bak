<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>Resume Builder - TapUniverse Native Studio</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:wght@600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
            serif: ['"Playfair Display"', 'serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          colors: {
            tap: {
              50: '#f0fdf4',
              100: '#dcfce7',
              500: '#10b981',
              600: '#059669',
              700: '#047857',
              900: '#064e3b',
            }
          }
        }
      }
    }
  </script>

  <style>
    :root {
      --accent-color: #059669;
      --accent-light: #ecfdf5;
      --safe-top: env(safe-area-inset-top, 0px);
      --safe-bottom: env(safe-area-inset-bottom, 0px);
    }
    
    * { -webkit-tap-highlight-color: transparent; }
    body {
      padding-top: var(--safe-top);
      padding-bottom: var(--safe-bottom);
      user-select: none;
    }
    input, textarea { user-select: auto; }

    /* Hide scrollbars for slick app feel */
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    /* A4 Aspect Ratio & Print Standards */
    .a4-canvas {
      aspect-ratio: 210 / 297;
      width: 100%;
      box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.12), 0 0 1px 1px rgba(0, 0, 0, 0.05);
    }

    @media print {
      body * { visibility: hidden !important; }
      #printable-resume, #printable-resume * { visibility: visible !important; }
      #printable-resume {
        position: fixed !important;
        left: 0 !important;
        top: 0 !important;
        width: 100% !important;
        height: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        border: none !important;
        box-shadow: none !important;
      }
      .no-print { display: none !important; }
    }
  </style>
</head>

<body class="bg-slate-50 dark:bg-[#090d16] text-slate-900 dark:text-slate-100 min-h-screen flex flex-col font-sans transition-colors duration-200">

  <!-- Top Header Navigation -->
  <header class="no-print sticky top-0 z-40 bg-white/90 dark:bg-[#0f172a]/90 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800/80 px-4 py-3 flex items-center justify-between shadow-xs">
    <div class="flex items-center space-x-2.5">
      <div class="w-9 h-9 rounded-2xl bg-gradient-to-tr from-emerald-600 to-teal-500 flex items-center justify-center text-white shadow-md shadow-emerald-500/20">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      </div>
      <div>
        <h1 class="font-extrabold text-sm tracking-tight text-slate-900 dark:text-white flex items-center gap-1.5">
          ResumeForge
          <span class="text-[9px] font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 px-1.5 py-0.5 rounded-md">PRO</span>
        </h1>
        <p class="text-[10px] font-medium text-slate-500 dark:text-slate-400">CV Maker & Multi-Template Studio</p>
      </div>
    </div>

    <!-- Top Action Buttons -->
    <div class="flex items-center space-x-2">
      <button onclick="toggleTheme()" class="p-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition">
        <svg id="theme-icon-sun" class="w-4 h-4 hidden" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 100 2h1z"/></svg>
        <svg id="theme-icon-moon" class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/></svg>
      </button>

      <button onclick="handleExportPdf()" class="px-3.5 py-1.5 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold text-xs shadow-md shadow-emerald-600/20 flex items-center space-x-1.5 active:scale-95 transition">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
        <span>Export</span>
      </button>
    </div>
  </header>

  <!-- Content Screens Container -->
  <main class="flex-1 pb-24 max-w-xl w-full mx-auto p-4">

    <!-- ============================================== -->
    <!-- SCREEN 1: TAPUNIVERSE STYLE DASHBOARD (HOME) -->
    <!-- ============================================== -->
    <div id="screen-dashboard" class="space-y-5">
      
      <!-- Profile Completion Card -->
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 to-slate-800 text-white p-5 shadow-xl">
        <div class="absolute -right-8 -bottom-8 w-36 h-36 rounded-full bg-emerald-500/10 blur-2xl pointer-events-none"></div>
        <div class="flex items-center justify-between">
          <div class="space-y-1">
            <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-400">Target ATS Readiness</span>
            <h2 id="dash-name" class="text-lg font-extrabold tracking-tight">Alex Rivera</h2>
            <p id="dash-role" class="text-xs text-slate-300">Senior Mobile Systems Architect</p>
          </div>
          <!-- Circular Progress Ring -->
          <div class="relative w-16 h-16 flex items-center justify-center">
            <svg class="w-full h-full transform -rotate-90" viewBox="0 0 36 36">
              <path class="text-slate-700" stroke-width="3.5" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
              <path id="progress-circle" class="text-emerald-500" stroke-dasharray="92, 100" stroke-width="3.5" stroke-linecap="round" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
            </svg>
            <span id="dash-score" class="absolute text-xs font-black">92%</span>
          </div>
        </div>

        <div class="mt-4 pt-4 border-t border-slate-800/80 flex items-center justify-between text-xs">
          <span class="text-slate-400">Status: <strong class="text-emerald-400">Ready to Apply</strong></span>
          <button onclick="switchScreen('editor')" class="text-xs font-bold text-emerald-400 hover:text-emerald-300 flex items-center gap-1">
            Edit Details →
          </button>
        </div>
      </div>

      <!-- Quick Actions Grid -->
      <div class="grid grid-cols-2 gap-3.5">
        <button onclick="switchScreen('editor')" class="flex items-center space-x-3 p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs hover:border-emerald-500/50 active:scale-[0.98] transition">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
          </div>
          <div class="text-left">
            <h3 class="font-bold text-xs">Edit Content</h3>
            <p class="text-[10px] text-slate-500">Update work & skills</p>
          </div>
        </button>

        <button onclick="switchScreen('preview')" class="flex items-center space-x-3 p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs hover:border-emerald-500/50 active:scale-[0.98] transition">
          <div class="w-10 h-10 rounded-xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
          </div>
          <div class="text-left">
            <h3 class="font-bold text-xs">Live Preview</h3>
            <p class="text-[10px] text-slate-500">Zoomable A4 page</p>
          </div>
        </button>
      </div>

      <!-- Template Catalog Quick-Pick -->
      <div class="space-y-3">
        <div class="flex justify-between items-center px-1">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400">Featured Templates</h3>
          <span class="text-[10px] font-semibold text-emerald-600 dark:text-emerald-400">4 ATS Styles Ready</span>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div onclick="selectTemplate('modern')" id="card-tpl-modern" class="p-3.5 rounded-2xl bg-white dark:bg-slate-900 border-2 border-emerald-500 dark:border-emerald-500 shadow-xs cursor-pointer">
            <div class="w-full h-24 rounded-lg bg-emerald-50 dark:bg-emerald-950/30 flex flex-col justify-between p-2 mb-2 border border-emerald-100 dark:border-emerald-900/40">
              <div class="w-1/3 h-2 bg-emerald-600 rounded-sm"></div>
              <div class="space-y-1">
                <div class="w-full h-1.5 bg-slate-200 dark:bg-slate-700 rounded-sm"></div>
                <div class="w-2/3 h-1.5 bg-slate-200 dark:bg-slate-700 rounded-sm"></div>
              </div>
            </div>
            <p class="font-bold text-xs">Modern Executive</p>
            <p class="text-[10px] text-slate-500">Split Header, Tech Focus</p>
          </div>

          <div onclick="selectTemplate('minimal')" id="card-tpl-minimal" class="p-3.5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs cursor-pointer">
            <div class="w-full h-24 rounded-lg bg-slate-100 dark:bg-slate-800/40 flex flex-col justify-between p-2 mb-2 border border-slate-200 dark:border-slate-800">
              <div class="w-1/2 h-2 bg-slate-800 dark:bg-slate-300 rounded-sm"></div>
              <div class="space-y-1">
                <div class="w-full h-1.5 bg-slate-200 dark:bg-slate-700 rounded-sm"></div>
                <div class="w-3/4 h-1.5 bg-slate-200 dark:bg-slate-700 rounded-sm"></div>
              </div>
            </div>
            <p class="font-bold text-xs">Clean Minimalist</p>
            <p class="text-[10px] text-slate-500">Pure ATS Monochrome</p>
          </div>
        </div>
      </div>
    </div>

    <!-- ============================================== -->
    <!-- SCREEN 2: MULTI-STEP SECTION WIZARD (EDITOR) -->
    <!-- ============================================== -->
    <div id="screen-editor" class="space-y-4 hidden">
      
      <div class="flex items-center justify-between pb-2 border-b border-slate-200 dark:border-slate-800">
        <div>
          <h2 class="text-base font-extrabold tracking-tight">Resume Information</h2>
          <p class="text-[10px] text-slate-500">All fields update the preview in real-time</p>
        </div>
        <button onclick="switchScreen('preview')" class="text-xs font-bold px-3 py-1.5 rounded-xl bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400">
          Preview Resume
        </button>
      </div>

      <!-- Section: Personal Info -->
      <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-xs space-y-3">
        <h3 class="text-xs font-extrabold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider flex items-center gap-1.5">
          <span>👤</span> Personal Details
        </h3>
        <div>
          <label class="text-[10px] font-bold text-slate-500 uppercase">Full Name</label>
          <input id="in-name" type="text" value="Alex Rivera" class="w-full mt-1 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-xs font-semibold focus:border-emerald-500 outline-none" />
        </div>
        <div>
          <label class="text-[10px] font-bold text-slate-500 uppercase">Professional Title</label>
          <input id="in-role" type="text" value="Senior Mobile Systems Architect" class="w-full mt-1 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-xs font-semibold focus:border-emerald-500 outline-none" />
        </div>
        <div class="grid grid-cols-2 gap-2.5">
          <div>
            <label class="text-[10px] font-bold text-slate-500 uppercase">Email</label>
            <input id="in-email" type="email" value="alex.rivera@forge.io" class="w-full mt-1 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-xs focus:border-emerald-500 outline-none" />
          </div>
          <div>
            <label class="text-[10px] font-bold text-slate-500 uppercase">Phone</label>
            <input id="in-phone" type="text" value="+1 (555) 019-2831" class="w-full mt-1 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-xs focus:border-emerald-500 outline-none" />
          </div>
        </div>
      </div>

      <!-- Section: Executive Summary -->
      <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-xs space-y-3">
        <div class="flex items-center justify-between">
          <h3 class="text-xs font-extrabold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider flex items-center gap-1.5">
            <span>🎯</span> Executive Summary
          </h3>
          <button onclick="aiPolishSummary()" class="text-[10px] font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 px-2 py-1 rounded-lg">
            ✨ AI Enhance
          </button>
        </div>
        <textarea id="in-summary" rows="3" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl p-3 text-xs leading-relaxed focus:border-emerald-500 outline-none">Results-driven Mobile Systems Architect with 7+ years of experience designing high-throughput offline engines, cross-platform Android runtime optimizations, and automated deployment pipelines.</textarea>
      </div>

      <!-- Section: Work Experience -->
      <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-xs space-y-3">
        <h3 class="text-xs font-extrabold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider flex items-center gap-1.5">
          <span>💼</span> Experience
        </h3>
        
        <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800 space-y-2">
          <div class="grid grid-cols-2 gap-2">
            <input id="in-exp1-role" type="text" value="Lead Systems Architect" placeholder="Job Title" class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg p-2 text-xs font-semibold" />
            <input id="in-exp1-comp" type="text" value="Vanguard Core Systems" placeholder="Company" class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg p-2 text-xs font-semibold" />
          </div>
          <input id="in-exp1-date" type="text" value="2023 - Present" class="w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg p-2 text-[10px]" />
          <textarea id="in-exp1-desc" rows="2" class="w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg p-2 text-xs leading-relaxed">Pioneered zero-latency mobile synchronizer reducing memory footprints by 42% across 300K monthly active mobile sessions.</textarea>
        </div>
      </div>

      <!-- Section: Skills (Chips) -->
      <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-xs space-y-3">
        <h3 class="text-xs font-extrabold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider flex items-center gap-1.5">
          <span>🛠️</span> Technical Skills
        </h3>
        <input id="in-skills" type="text" value="Android Architecture, TypeScript, Kotlin, Capacitor, Vercel CI/CD, SQLite, Tailwind" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-xs font-medium focus:border-emerald-500 outline-none" />
        <p class="text-[9.5px] text-slate-400">Separate multiple skills with commas to create ATS tags.</p>
      </div>
    </div>

    <!-- ============================================== -->
    <!-- SCREEN 3: LIVE ZOOMABLE A4 PREVIEW & DOCK -->
    <!-- ============================================== -->
    <div id="screen-preview" class="space-y-4 hidden">
      
      <!-- Preview Options Pill Bar -->
      <div class="flex items-center justify-between px-1">
        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">A4 Page View</span>
        <div class="flex items-center space-x-1.5">
          <button onclick="setAccent('#059669')" class="w-5 h-5 rounded-full bg-emerald-600 ring-2 ring-white dark:ring-slate-900 shadow-xs"></button>
          <button onclick="setAccent('#2563eb')" class="w-5 h-5 rounded-full bg-blue-600 ring-2 ring-white dark:ring-slate-900 shadow-xs"></button>
          <button onclick="setAccent('#4f46e5')" class="w-5 h-5 rounded-full bg-indigo-600 ring-2 ring-white dark:ring-slate-900 shadow-xs"></button>
          <button onclick="setAccent('#0f172a')" class="w-5 h-5 rounded-full bg-slate-900 ring-2 ring-white dark:ring-slate-900 shadow-xs"></button>
        </div>
      </div>

      <!-- Printable A4 Interactive Preview Sheet -->
      <div class="flex justify-center w-full">
        <div id="printable-resume" class="a4-canvas bg-white text-slate-900 rounded-2xl p-6 flex flex-col justify-between overflow-hidden relative">
          
          <div>
            <!-- Header section with dynamic accent -->
            <div id="resume-header" class="border-b-2 border-emerald-600 pb-3 mb-3">
              <h1 id="out-name" class="text-xl font-extrabold tracking-tight text-slate-900 uppercase">ALEX RIVERA</h1>
              <p id="out-role" class="text-xs font-bold text-emerald-600 uppercase tracking-wider mt-0.5">Senior Mobile Systems Architect</p>
              <p id="out-contact" class="text-[9.5px] text-slate-500 mt-1 font-medium">alex.rivera@forge.io  •  +1 (555) 019-2831</p>
            </div>

            <!-- Summary Section -->
            <div class="mb-4">
              <h2 class="text-[10.5px] font-extrabold text-slate-800 uppercase tracking-wider mb-1">Professional Profile</h2>
              <p id="out-summary" class="text-[9.5px] text-slate-700 leading-relaxed">Results-driven Mobile Systems Architect with 7+ years of experience designing high-throughput offline engines, cross-platform Android runtime optimizations, and automated deployment pipelines.</p>
            </div>

            <!-- Experience Section -->
            <div class="mb-4">
              <h2 class="text-[10.5px] font-extrabold text-slate-800 uppercase tracking-wider mb-1.5">Employment Experience</h2>
              <div class="space-y-2">
                <div>
                  <div class="flex justify-between items-baseline">
                    <span id="out-exp1-role" class="text-[10px] font-bold text-slate-900">Lead Systems Architect</span>
                    <span id="out-exp1-date" class="text-[9px] text-slate-500 font-medium">2023 - Present</span>
                  </div>
                  <div id="out-exp1-comp" class="text-[9px] font-semibold text-emerald-700">Vanguard Core Systems</div>
                  <p id="out-exp1-desc" class="text-[9px] text-slate-600 mt-0.5 leading-normal">Pioneered zero-latency mobile synchronizer reducing memory footprints by 42% across 300K monthly active mobile sessions.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Skills section -->
          <div>
            <h2 class="text-[10.5px] font-extrabold text-slate-800 uppercase tracking-wider mb-1.5">Skills & Competencies</h2>
            <div id="out-skills" class="flex flex-wrap gap-1">
              <!-- Skill chips populate here -->
            </div>
          </div>

        </div>
      </div>
    </div>

  </main>

  <!-- Bottom App Navigation Bar (TapUniverse Pattern) -->
  <nav class="no-print fixed bottom-0 left-0 right-0 z-50 bg-white/95 dark:bg-[#090d16]/95 backdrop-blur-lg border-t border-slate-200 dark:border-slate-800/80 px-6 py-2 flex items-center justify-around shadow-2xl">
    <button onclick="switchScreen('dashboard')" id="nav-dashboard" class="flex flex-col items-center gap-1 text-emerald-600 dark:text-emerald-400 font-bold transition">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
      <span class="text-[9.5px]">Home</span>
    </button>

    <button onclick="switchScreen('editor')" id="nav-editor" class="flex flex-col items-center gap-1 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 font-medium transition">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
      <span class="text-[9.5px]">Editor</span>
    </button>

    <button onclick="switchScreen('preview')" id="nav-preview" class="flex flex-col items-center gap-1 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 font-medium transition">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
      <span class="text-[9.5px]">Preview</span>
    </button>
  </nav>

  <!-- Application Logic & Data Sync Engine -->
  <script>
    // State management & LocalStorage
    const STATE_KEY = 'tapuniverse_resume_state_v1';
    let currentAccent = '#059669';

    const bindInput = (id, outId, onUpdate) => {
      const el = document.getElementById(id);
      if (!el) return;
      el.addEventListener('input', () => {
        const out = document.getElementById(outId);
        if (out) out.innerText = el.value;
        if (onUpdate) onUpdate(el.value);
        saveState();
      });
    };

    // Initialize Two-Way Data Binding
    bindInput('in-name', 'out-name', val => { document.getElementById('dash-name').innerText = val; });
    bindInput('in-role', 'out-role', val => { document.getElementById('dash-role').innerText = val; });
    bindInput('in-summary', 'out-summary');
    bindInput('in-exp1-role', 'out-exp1-role');
    bindInput('in-exp1-comp', 'out-exp1-comp');
    bindInput('in-exp1-date', 'out-exp1-date');
    bindInput('in-exp1-desc', 'out-exp1-desc');

    const updateContact = () => {
      const email = document.getElementById('in-email').value;
      const phone = document.getElementById('in-phone').value;
      document.getElementById('out-contact').innerText = `${email}  •  ${phone}`;
      saveState();
    };
    document.getElementById('in-email').addEventListener('input', updateContact);
    document.getElementById('in-phone').addEventListener('input', updateContact);

    const renderSkills = () => {
      const skills = document.getElementById('in-skills').value.split(',');
      const container = document.getElementById('out-skills');
      container.innerHTML = skills.map(s => `
        <span class="px-2 py-0.5 rounded text-[8.5px] font-bold" style="background-color: ${currentAccent}15; color: ${currentAccent}">
          ${s.trim()}
        </span>
      `).join('');
      saveState();
    };
    document.getElementById('in-skills').addEventListener('input', renderSkills);

    // Screen Switching
    function switchScreen(screen) {
      ['dashboard', 'editor', 'preview'].forEach(s => {
        document.getElementById(`screen-${s}`).classList.add('hidden');
        const nav = document.getElementById(`nav-${s}`);
        nav.classList.remove('text-emerald-600', 'dark:text-emerald-400', 'font-bold');
        nav.classList.add('text-slate-400', 'font-medium');
      });

      document.getElementById(`screen-${screen}`).classList.remove('hidden');
      const activeNav = document.getElementById(`nav-${screen}`);
      activeNav.classList.add('text-emerald-600', 'dark:text-emerald-400', 'font-bold');
      activeNav.classList.remove('text-slate-400', 'font-medium');
      window.scrollTo(0, 0);
    }

    // Dynamic Color Palette Switcher
    function setAccent(color) {
      currentAccent = color;
      document.getElementById('resume-header').style.borderColor = color;
      document.getElementById('out-role').style.color = color;
      renderSkills();
    }

    // AI Polish Quick Action
    function aiPolishSummary() {
      const enhanced = "Accomplished Mobile Architect specializing in distributed client sync engines, cross-platform Android native integrations, and resilient CI/CD pipelines that optimize performance benchmarks by up to 40%.";
      document.getElementById('in-summary').value = enhanced;
      document.getElementById('out-summary').innerText = enhanced;
      saveState();
    }

    // Theme Switcher (Dark/Light)
    function toggleTheme() {
      const isDark = document.documentElement.classList.toggle('dark');
      document.getElementById('theme-icon-sun').classList.toggle('hidden', !isDark);
      document.getElementById('theme-icon-moon').classList.toggle('hidden', isDark);
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    }

    // PDF Export & Native Android Bridge Support
    function handleExportPdf() {
      if (window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.PdfExportPlugin) {
        window.Capacitor.Plugins.PdfExportPlugin.savePdf({ html: document.getElementById('printable-resume').outerHTML });
      } else {
        window.print();
      }
    }

    // Local Storage Persistence
    function saveState() {
      const data = {
        name: document.getElementById('in-name').value,
        role: document.getElementById('in-role').value,
        email: document.getElementById('in-email').value,
        phone: document.getElementById('in-phone').value,
        summary: document.getElementById('in-summary').value,
        skills: document.getElementById('in-skills').value,
        accent: currentAccent
      };
      localStorage.setItem(STATE_KEY, JSON.stringify(data));
    }

    function loadState() {
      const raw = localStorage.getItem(STATE_KEY);
      if (!raw) { renderSkills(); return; }
      try {
        const d = JSON.parse(raw);
        if (d.name) { document.getElementById('in-name').value = d.name; document.getElementById('out-name').innerText = d.name; document.getElementById('dash-name').innerText = d.name; }
        if (d.role) { document.getElementById('in-role').value = d.role; document.getElementById('out-role').innerText = d.role; document.getElementById('dash-role').innerText = d.role; }
        if (d.email) document.getElementById('in-email').value = d.email;
        if (d.phone) document.getElementById('in-phone').value = d.phone;
        if (d.summary) { document.getElementById('in-summary').value = d.summary; document.getElementById('out-summary').innerText = d.summary; }
        if (d.skills) document.getElementById('in-skills').value = d.skills;
        if (d.accent) setAccent(d.accent);
        updateContact();
        renderSkills();
      } catch (e) {
        renderSkills();
      }
    }

    // Initialize on boot
    loadState();
    if (localStorage.getItem('theme') === 'dark') toggleTheme();
  </script>
</body>
</html>
