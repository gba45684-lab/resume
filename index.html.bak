<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ResumeForge Live Studio</title>
  <script>
    tailwind = {
      darkMode: 'class'
    }
  </script>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
    @media print {
      body * { visibility: hidden; }
      #resume-preview, #resume-preview * { visibility: visible; }
      #resume-preview { position: absolute; left: 0; top: 0; width: 100%; box-shadow: none; }
      .no-print { display: none !important; }
    }
  </style>
</head>
<body class="bg-slate-100 dark:bg-[#0b0f19] text-slate-800 dark:text-slate-100 min-h-screen transition-colors duration-300">

  <!-- Floating Dark Mode Toggle Button -->
  <button id="theme-toggle" onclick="toggleDarkMode()" class="no-print fixed top-2.5 right-3 z-[60] p-2 rounded-xl bg-white/10 dark:bg-slate-800/80 text-white dark:text-amber-400 border border-white/20 dark:border-slate-700 shadow-lg backdrop-blur transition-all duration-200 flex items-center justify-center hover:scale-105 active:scale-95" title="Toggle Light/Dark Mode" aria-label="Toggle Theme">
    <svg id="theme-toggle-dark-icon" class="w-5 h-5 hidden" fill="currentColor" viewBox="0 0 20 20">
      <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
    </svg>
    <svg id="theme-toggle-light-icon" class="w-5 h-5 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
      <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 100 2h1z" clip-rule="evenodd"></path>
    </svg>
  </button>

  <!-- Navigation Bar -->
  <header class="no-print border-b border-indigo-900/50 bg-gradient-to-r from-[#1e1b4b] to-[#312e81] text-white sticky top-0 z-50 px-4 py-3 flex items-center justify-between shadow-lg">
    <div class="flex items-center space-x-3">
      <div class="w-9 h-9 rounded-xl bg-white/10 backdrop-blur border border-white/20 flex items-center justify-center shadow-md">
        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
      </div>
      <div>
        <h1 class="font-extrabold text-sm tracking-wider uppercase text-white">ResumeForge</h1>
        <p class="text-[10px] text-indigo-200">Live Over-The-Air Studio</p>
      </div>
    </div>
    <div class="flex items-center space-x-2 mr-12">
      <span id="ats-badge" class="px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-400/30">
        ATS: 85%
      </span>
      <button onclick="window.print()" class="px-3 py-1.5 bg-indigo-500 hover:bg-indigo-400 text-white rounded-lg text-xs font-bold shadow-md shadow-indigo-950/40 transition">
        Export PDF
      </button>
    </div>
  </header>

  <!-- Main Container -->
  <main class="max-w-6xl mx-auto p-4 grid grid-cols-1 lg:grid-cols-2 gap-6">
    
    <!-- Editor Form -->
    <section class="no-print space-y-4">
      <div class="bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 space-y-3 shadow-sm dark:shadow-none transition-colors duration-300">
        <h2 class="text-xs font-bold tracking-wider text-indigo-600 dark:text-indigo-400 uppercase">Profile Details</h2>
        <div>
          <label class="text-[11px] text-slate-500 dark:text-slate-400">Full Name</label>
          <input id="input-name" type="text" value="Alex Rivera" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg px-3 py-2 text-sm focus:border-indigo-500 outline-none transition-colors duration-300" />
        </div>
        <div>
          <label class="text-[11px] text-slate-500 dark:text-slate-400">Role / Title</label>
          <input id="input-role" type="text" value="Senior Mobile Systems Architect" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg px-3 py-2 text-sm focus:border-indigo-500 outline-none transition-colors duration-300" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="text-[11px] text-slate-500 dark:text-slate-400">Email</label>
            <input id="input-email" type="email" value="alex.rivera@forge.io" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg px-3 py-2 text-sm focus:border-indigo-500 outline-none transition-colors duration-300" />
          </div>
          <div>
            <label class="text-[11px] text-slate-500 dark:text-slate-400">Phone</label>
            <input id="input-phone" type="text" value="+1 (555) 019-2831" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg px-3 py-2 text-sm focus:border-indigo-500 outline-none transition-colors duration-300" />
          </div>
        </div>
      </div>

      <div class="bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 space-y-3 shadow-sm dark:shadow-none transition-colors duration-300">
        <div class="flex justify-between items-center">
          <h2 class="text-xs font-bold tracking-wider text-indigo-600 dark:text-indigo-400 uppercase">Executive Summary</h2>
          <button onclick="polishWithAI()" class="text-xs text-indigo-600 dark:text-indigo-400 hover:text-indigo-500 dark:hover:text-indigo-300 flex items-center space-x-1 font-semibold transition-colors">
            <span>✨ Polish AI</span>
          </button>
        </div>
        <textarea id="input-summary" rows="3" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg p-3 text-xs focus:border-indigo-500 outline-none transition-colors duration-300 leading-relaxed">High-impact engineer specialized in cross-platform native rendering engines, sub-millisecond data sync, and resilient mobile architectures.</textarea>
      </div>

      <div class="bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 space-y-3 shadow-sm dark:shadow-none transition-colors duration-300">
        <h2 class="text-xs font-bold tracking-wider text-indigo-600 dark:text-indigo-400 uppercase">Skills (Comma Separated)</h2>
        <input id="input-skills" type="text" value="Flutter, Dart, Rust, WebAssembly, CI/CD, Docker, SQLite" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg px-3 py-2 text-sm focus:border-indigo-500 outline-none transition-colors duration-300" />
      </div>
    </section>

    <!-- Live A4 Resume Preview -->
    <section class="flex justify-center">
      <div id="resume-preview" class="w-full max-w-[500px] aspect-[1/1.414] bg-white text-slate-900 rounded-xl shadow-2xl p-6 flex flex-col justify-between text-left">
        <div>
          <h1 id="preview-name" class="text-2xl font-black text-indigo-950 tracking-tight">ALEX RIVERA</h1>
          <p id="preview-role" class="text-xs font-bold text-indigo-600 tracking-wide uppercase mt-0.5">Senior Mobile Systems Architect</p>
          <p id="preview-contact" class="text-[10px] text-slate-500 mt-1">alex.rivera@forge.io  •  +1 (555) 019-2831</p>
          
          <hr class="my-3 border-slate-200" />
          
          <h2 class="text-[11px] font-bold text-indigo-900 uppercase tracking-wider">Executive Summary</h2>
          <p id="preview-summary" class="text-[10.5px] text-slate-700 mt-1 leading-relaxed">High-impact engineer specialized in cross-platform native rendering engines, sub-millisecond data sync, and resilient mobile architectures.</p>

          <h2 class="text-[11px] font-bold text-indigo-900 uppercase tracking-wider mt-4">Experience Highlights</h2>
          <div class="mt-1 space-y-2">
            <div>
              <div class="flex justify-between text-[10px] font-bold text-slate-800">
                <span>Vanguard Tech Core</span>
                <span class="text-slate-500">2023 - Present</span>
              </div>
              <p class="text-[9.5px] text-slate-600 mt-0.5 leading-normal">Engineered zero-latency mobile rendering pipeline reducing frame drop rates by 42%.</p>
            </div>
            <div>
              <div class="flex justify-between text-[10px] font-bold text-slate-800">
                <span>Apex Solutions</span>
                <span class="text-slate-500">2021 - 2023</span>
              </div>
              <p class="text-[9.5px] text-slate-600 mt-0.5 leading-normal">Scaled offline-first synchronization infrastructure serving 200,000+ active users.</p>
            </div>
          </div>
        </div>

        <div>
          <h2 class="text-[11px] font-bold text-indigo-900 uppercase tracking-wider">Core Capabilities</h2>
          <div id="preview-skills" class="flex flex-wrap gap-1.5 mt-1.5">
            <!-- Badges render here -->
          </div>
        </div>
      </div>
    </section>

  </main>

  <script>
    function toggleDarkMode() {
      const html = document.documentElement;
      const darkIcon = document.getElementById('theme-toggle-dark-icon');
      const lightIcon = document.getElementById('theme-toggle-light-icon');

      if (html.classList.contains('dark')) {
        html.classList.remove('dark');
        darkIcon.classList.remove('hidden');
        lightIcon.classList.add('hidden');
        localStorage.setItem('theme', 'light');
      } else {
        html.classList.add('dark');
        darkIcon.classList.add('hidden');
        lightIcon.classList.remove('hidden');
        localStorage.setItem('theme', 'dark');
      }
    }

    if (localStorage.getItem('theme') === 'light') {
      document.documentElement.classList.remove('dark');
      document.getElementById('theme-toggle-dark-icon').classList.remove('hidden');
      document.getElementById('theme-toggle-light-icon').classList.add('hidden');
    }

    const bind = (id, target, callback) => {
      document.getElementById(id).addEventListener('input', (e) => {
        document.getElementById(target).innerText = e.target.value;
        if (callback) callback();
      });
    };

    bind('input-name', 'preview-name');
    bind('input-role', 'preview-role');
    bind('input-summary', 'preview-summary');

    const updateContact = () => {
      const email = document.getElementById('input-email').value;
      const phone = document.getElementById('input-phone').value;
      document.getElementById('preview-contact').innerText = `${email}  •  ${phone}`;
    };

    document.getElementById('input-email').addEventListener('input', updateContact);
    document.getElementById('input-phone').addEventListener('input', updateContact);

    const updateSkills = () => {
      const skills = document.getElementById('input-skills').value.split(',');
      const container = document.getElementById('preview-skills');
      container.innerHTML = skills.map(s => `<span class="bg-indigo-50 text-indigo-700 px-2 py-0.5 rounded text-[9px] font-semibold">${s.trim()}</span>`).join('');
    };

    document.getElementById('input-skills').addEventListener('input', updateSkills);
    updateSkills();

    function polishWithAI() {
      const field = document.getElementById('input-summary');
      field.value = "Engineered enterprise mobile architectures that elevated ATS benchmarks by 35% while cutting client compute latency across cross-functional pipelines.";
      document.getElementById('preview-summary').innerText = field.value;
      document.getElementById('ats-badge').innerText = "ATS: 98%";
    }
  </script>
</body>
</html>