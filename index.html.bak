<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>TapUniverse CV Maker - VisionOS Spatial Resume Builder</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600;1,700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
            serif: ['"Playfair Display"', 'serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          colors: {
            tap: {
              50: '#f0fdf4',
              100: '#dcfce7',
              500: '#10b981',
              600: '#059669',
              700: '#047857',
              900: '#064e3b',
            }
          },
          animation: {
            'float-slow': 'float 12s ease-in-out infinite',
            'float-reverse': 'floatReverse 14s ease-in-out infinite',
            'pulse-glow': 'pulseGlow 6s ease-in-out infinite',
            'shimmer': 'shimmer 4s linear infinite',
          },
          keyframes: {
            float: {
              '0%, 100%': { transform: 'translate(0px, 0px) scale(1) rotate(0deg)' },
              '50%': { transform: 'translate(25px, -35px) scale(1.1) rotate(5deg)' },
            },
            floatReverse: {
              '0%, 100%': { transform: 'translate(0px, 0px) scale(1) rotate(0deg)' },
              '50%': { transform: 'translate(-35px, 25px) scale(1.15) rotate(-5deg)' },
            },
            pulseGlow: {
              '0%, 100%': { opacity: '0.35', filter: 'blur(100px)' },
              '50%': { opacity: '0.7', filter: 'blur(130px)' },
            },
            shimmer: {
              '0%': { transform: 'translateX(-100%)' },
              '100%': { transform: 'translateX(200%)' },
            }
          }
        }
      }
    }
  </script>

  <style>
    :root {
      --accent-color: #059669;
      --safe-top: env(safe-area-inset-top, 0px);
      --safe-bottom: env(safe-area-inset-bottom, 0px);
    }
    
    * { 
      -webkit-tap-highlight-color: transparent; 
      box-sizing: border-box;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    
    body {
      padding-top: var(--safe-top);
      padding-bottom: calc(var(--safe-bottom) + 100px);
      user-select: none;
      touch-action: manipulation;
      background-color: #03050a;
      overflow-x: hidden;
    }

    input, textarea, [contenteditable="true"] { 
      user-select: auto; 
    }

    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    /* VisionOS Spatial Glassmorphism Elements */
    .spatial-glass {
      background: rgba(255, 255, 255, 0.45);
      backdrop-filter: blur(30px) saturate(210%);
      -webkit-backdrop-filter: blur(30px) saturate(210%);
      border: 1px solid rgba(255, 255, 255, 0.45);
      border-top: 1px solid rgba(255, 255, 255, 0.7);
      box-shadow: 
        0 4px 30px rgba(0, 0, 0, 0.03),
        0 16px 40px -10px rgba(0, 0, 0, 0.05),
        inset 0 1px 1px 0 rgba(255, 255, 255, 0.6);
    }

    .dark .spatial-glass {
      background: rgba(18, 24, 38, 0.45);
      backdrop-filter: blur(30px) saturate(210%);
      -webkit-backdrop-filter: blur(30px) saturate(210%);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-top: 1px solid rgba(255, 255, 255, 0.2);
      box-shadow: 
        0 4px 30px rgba(0, 0, 0, 0.2),
        0 20px 50px -15px rgba(0, 0, 0, 0.5), 
        inset 0 1px 1px 0 rgba(255, 255, 255, 0.1);
    }

    .spatial-card {
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease, border-color 0.4s ease;
    }
    .spatial-card:hover {
      transform: translateY(-4px) scale(1.02);
      border-color: rgba(255, 255, 255, 0.25);
      box-shadow: 
        0 20px 40px -10px rgba(0, 0, 0, 0.4),
        0 0 20px 2px rgba(255, 255, 255, 0.05);
    }
    .spatial-card:active {
      transform: translateY(-1px) scale(0.99);
    }

    /* Iridescent Selection Dock & Sheen */
    .iridescent-dock {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.6), rgba(255, 255, 255, 0.35));
      backdrop-filter: blur(32px) saturate(220%);
      -webkit-backdrop-filter: blur(32px) saturate(220%);
      border: 1px solid rgba(255, 255, 255, 0.5);
      box-shadow: 
        0 24px 48px rgba(0,0,0,0.06), 
        0 0 30px rgba(99, 102, 241, 0.08);
    }
    .dark .iridescent-dock {
      background: linear-gradient(135deg, rgba(30, 41, 59, 0.45), rgba(15, 23, 42, 0.4));
      backdrop-filter: blur(32px) saturate(220%);
      -webkit-backdrop-filter: blur(32px) saturate(220%);
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 
        0 30px 60px rgba(0,0,0,0.45), 
        0 0 30px rgba(16, 185, 129, 0.12);
    }

    /* 3D Coverflow Container */
    .coverflow-viewport {
      perspective: 1200px;
      perspective-origin: 50% 50%;
      touch-action: pan-y;
      cursor: grab;
    }
    .coverflow-viewport:active {
      cursor: grabbing;
    }
    .coverflow-track {
      transform-style: preserve-3d;
      transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .coverflow-item {
      transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.45s ease, filter 0.45s ease;
      transform-style: preserve-3d;
      will-change: transform, opacity;
      backface-visibility: hidden;
    }

    .a4-container {
      width: 794px;
      min-height: 1123px;
      background: #ffffff;
      box-shadow: 0 30px 70px -20px rgba(0, 0, 0, 0.35), 0 0 1px 1px rgba(0, 0, 0, 0.06);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      color: #0f172a;
    }

    @media print {
      body * { visibility: hidden !important; }
      #printable-resume, #printable-resume * { visibility: visible !important; }
      #printable-resume {
        position: absolute !important;
        left: 0 !important;
        top: 0 !important;
        width: 100% !important;
        min-height: 100vh !important;
        margin: 0 !important;
        padding: 2.5rem !important;
        box-shadow: none !important;
        border-radius: 0 !important;
        transform: scale(1) !important;
      }
      .no-print { display: none !important; }
    }

    .tap-active {
      transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.18s ease;
    }
    .tap-active:active {
      transform: scale(0.95);
      opacity: 0.85;
    }

    .tpl-font-sans { font-family: 'Plus Jakarta Sans', sans-serif; }
    .tpl-font-serif { font-family: 'Playfair Display', serif; }
    .tpl-font-mono { font-family: 'JetBrains Mono', monospace; }

    .toast-animate {
      animation: toastIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes toastIn {
      from { opacity: 0; transform: translate(-50%, 20px) scale(0.9); }
      to { opacity: 1; transform: translate(-50%, 0) scale(1); }
    }

    /* Specular Reflection Glow & Hover Light */
    .specular-sheen {
      position: relative;
      overflow: hidden;
    }
    .specular-sheen::after {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: linear-gradient(60deg, transparent 35%, rgba(255,255,255,0.18) 50%, transparent 65%);
      transform: rotate(25deg);
      pointer-events: none;
      animation: shimmer 8s ease-in-out infinite;
    }
  </style>
</head>

<body class="bg-slate-50 dark:bg-[#03050a] text-slate-900 dark:text-slate-100 min-h-screen flex flex-col font-sans transition-colors duration-300 relative selection:bg-emerald-500/30">

  <!-- FLOATING SPATIAL AMBIENT MESH GLOWS -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
    <div class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-gradient-to-br from-indigo-600/25 via-purple-500/15 to-pink-500/0 blur-[100px] animate-float-slow animate-pulse-glow"></div>
    <div class="absolute top-1/3 -right-32 w-[32rem] h-[32rem] rounded-full bg-gradient-to-tl from-emerald-500/20 via-teal-500/15 to-cyan-500/0 blur-[120px] animate-float-reverse"></div>
    <div class="absolute -bottom-32 left-1/4 w-[28rem] h-[28rem] rounded-full bg-gradient-to-tr from-blue-600/15 via-violet-600/15 to-emerald-400/0 blur-[100px] animate-float-slow"></div>
  </div>

  <!-- TOP SPATIAL HEADER BAR -->
  <header class="no-print sticky top-0 z-40 px-4 py-3 my-2 max-w-xl mx-auto w-full">
    <div class="spatial-glass rounded-[28px] px-4 py-2.5 flex items-center justify-between shadow-2xl">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-indigo-500 via-emerald-400 to-teal-500 flex items-center justify-center text-white shadow-lg shadow-emerald-500/20 ring-1 ring-white/30">
          <svg class="w-5.5 h-5.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        </div>
        <div>
          <h1 class="font-extrabold text-xs tracking-tight text-slate-900 dark:text-white flex items-center gap-1.5">
            TapUniverse
            <span class="text-[8px] font-black bg-gradient-to-r from-indigo-500 via-emerald-500 to-teal-500 text-white px-2 py-0.5 rounded-full tracking-widest shadow-xs uppercase">Vision CV</span>
          </h1>
          <p class="text-[9px] font-semibold text-slate-500 dark:text-slate-400">Spatial ATS Resume Studio</p>
        </div>
      </div>

      <div class="flex items-center space-x-2">
        <button onclick="loadSampleData()" title="Reset Sample Data" class="px-2.5 py-1.5 rounded-xl bg-white/30 dark:bg-slate-800/40 hover:bg-white/50 dark:hover:bg-slate-700/50 text-slate-700 dark:text-slate-300 text-[10px] font-black tracking-wide tap-active flex items-center gap-1 border border-white/20 backdrop-blur-md">
          <span>⚡ Demo</span>
        </button>

        <button onclick="toggleTheme()" aria-label="Toggle Theme" class="p-2 rounded-xl bg-white/30 dark:bg-slate-800/40 text-slate-700 dark:text-slate-300 hover:bg-white/50 dark:hover:bg-slate-700/50 transition tap-active border border-white/20 backdrop-blur-md">
          <svg id="theme-icon-sun" class="w-4 h-4 hidden" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 100 2h1z"/></svg>
          <svg id="theme-icon-moon" class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/></svg>
        </button>

        <button onclick="handleExportPdf()" class="px-3 py-1.5 rounded-xl bg-gradient-to-r from-emerald-500 via-teal-500 to-indigo-600 hover:opacity-95 text-white font-black text-xs shadow-lg shadow-emerald-500/20 flex items-center space-x-1.5 tap-active border border-white/20">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
          <span>Export</span>
        </button>
      </div>
    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <main class="flex-1 max-w-xl w-full mx-auto p-4 space-y-4 relative z-10">

    <!-- SCREEN 1: DASHBOARD / HOME -->
    <div id="screen-dashboard" class="space-y-4">
      
      <!-- Profile Readiness Spatial Glass Card -->
      <div class="relative overflow-hidden rounded-[32px] spatial-glass p-6 shadow-2xl specular-sheen border border-white/20">
        <div class="absolute -right-12 -top-12 w-48 h-48 rounded-full bg-emerald-500/10 blur-3xl pointer-events-none"></div>
        <div class="flex items-center justify-between relative z-10">
          <div class="space-y-2 pr-2">
            <span class="inline-flex items-center gap-1.5 text-[9px] font-black uppercase tracking-widest text-emerald-400 bg-emerald-950/60 dark:bg-emerald-950/80 px-2.5 py-1 rounded-full border border-emerald-500/30 backdrop-blur-md">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> ATS Readiness Engine
            </span>
            <h2 id="dash-name" class="text-2xl font-black tracking-tight text-slate-900 dark:text-white leading-none">Alex Rivera</h2>
            <p id="dash-role" class="text-xs font-semibold text-slate-600 dark:text-slate-300">Senior Mobile Systems Architect</p>
          </div>

          <!-- Circular ATS Score Ring -->
          <div class="relative w-24 h-24 flex-shrink-0 flex items-center justify-center">
            <svg class="w-22 h-22 transform -rotate-90" viewBox="0 0 36 36">
              <path class="text-slate-200 dark:text-slate-800/80" stroke-width="3" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
              <path id="progress-circle" class="text-emerald-500 transition-all duration-1000 ease-out" stroke-dasharray="0, 100" stroke-width="3" stroke-linecap="round" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
            </svg>
            <div class="absolute flex flex-col items-center justify-center text-center">
              <span id="dash-score" class="text-xl font-black text-slate-900 dark:text-white leading-none">0%</span>
              <span class="text-[8px] uppercase tracking-widest font-black text-emerald-500 dark:text-emerald-400 mt-0.5">ATS</span>
            </div>
          </div>
        </div>

        <div class="mt-5 pt-4 border-t border-slate-200/50 dark:border-white/10 flex items-center justify-between text-xs">
          <span class="text-slate-600 dark:text-slate-400 font-semibold">Grade: <strong id="dash-grade-text" class="text-emerald-500 dark:text-emerald-400 font-bold">Calculating...</strong></span>
          <button onclick="switchScreen('editor')" class="text-xs font-black text-emerald-600 dark:text-emerald-400 hover:text-emerald-500 flex items-center gap-1.5 tap-active px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 backdrop-blur-sm">
            <span>Optimise CV</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </button>
        </div>
      </div>

      <!-- Quick Action Grid -->
      <div class="grid grid-cols-2 gap-3.5">
        <button onclick="switchScreen('editor')" class="spatial-glass spatial-card p-4.5 rounded-3xl text-left flex items-center space-x-3.5 tap-active border border-white/20">
          <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-emerald-500/20 to-teal-500/20 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 flex items-center justify-center flex-shrink-0 shadow-sm">
            <svg class="w-5.5 h-5.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
          </div>
          <div>
            <h3 class="font-extrabold text-xs text-slate-900 dark:text-white">Edit Content</h3>
            <p class="text-[10px] font-medium text-slate-500 dark:text-slate-400 mt-0.5">Details & History</p>
          </div>
        </button>

        <button onclick="switchScreen('preview')" class="spatial-glass spatial-card p-4.5 rounded-3xl text-left flex items-center space-x-3.5 tap-active border border-white/20">
          <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-indigo-500/20 to-purple-500/20 border border-indigo-500/30 text-indigo-600 dark:text-indigo-400 flex items-center justify-center flex-shrink-0 shadow-sm">
            <svg class="w-5.5 h-5.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
          </div>
          <div>
            <h3 class="font-extrabold text-xs text-slate-900 dark:text-white">A4 Preview</h3>
            <p class="text-[10px] font-medium text-slate-500 dark:text-slate-400 mt-0.5">Export & Print</p>
          </div>
        </button>
      </div>

      <!-- Iridescent Color Dock -->
      <div class="iridescent-dock p-5 rounded-[28px] space-y-3.5 relative overflow-hidden">
        <div class="flex items-center justify-between">
          <h3 class="text-xs font-black uppercase tracking-widest text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
            <span>🎨</span> Accent Spatial Theme
          </h3>
          <span id="current-color-label" class="text-[10px] font-black text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 px-2.5 py-0.5 rounded-full border border-emerald-500/20">Emerald Green</span>
        </div>
        <div class="flex items-center justify-between gap-2 pt-1">
          <button onclick="setAccent('#059669', 'Emerald Green')" class="w-9 h-9 rounded-2xl bg-[#059669] shadow-md shadow-emerald-600/30 ring-2 ring-white/50 hover:scale-110 transition tap-active relative flex items-center justify-center" aria-label="Emerald Green"></button>
          <button onclick="setAccent('#2563eb', 'Royal Blue')" class="w-9 h-9 rounded-2xl bg-[#2563eb] shadow-md shadow-blue-600/30 ring-2 ring-white/50 hover:scale-110 transition tap-active relative flex items-center justify-center" aria-label="Royal Blue"></button>
          <button onclick="setAccent('#7c3aed', 'Indigo Purple')" class="w-9 h-9 rounded-2xl bg-[#7c3aed] shadow-md shadow-purple-600/30 ring-2 ring-white/50 hover:scale-110 transition tap-active relative flex items-center justify-center" aria-label="Indigo Purple"></button>
          <button onclick="setAccent('#dc2626', 'Crimson Red')" class="w-9 h-9 rounded-2xl bg-[#dc2626] shadow-md shadow-red-600/30 ring-2 ring-white/50 hover:scale-110 transition tap-active relative flex items-center justify-center" aria-label="Crimson Red"></button>
          <button onclick="setAccent('#d97706', 'Amber Gold')" class="w-9 h-9 rounded-2xl bg-[#d97706] shadow-md shadow-amber-600/30 ring-2 ring-white/50 hover:scale-110 transition tap-active relative flex items-center justify-center" aria-label="Amber Gold"></button>
          <button onclick="setAccent('#0f172a', 'Slate Dark')" class="w-9 h-9 rounded-2xl bg-[#0f172a] shadow-md shadow-slate-900/40 ring-2 ring-white/50 hover:scale-110 transition tap-active relative flex items-center justify-center" aria-label="Slate Dark"></button>
        </div>
      </div>

      <!-- Smooth 3D Coverflow Template Selector -->
      <div class="space-y-3 pt-2">
        <div class="flex justify-between items-center px-1">
          <h3 class="text-xs font-black uppercase tracking-widest text-slate-700 dark:text-slate-300">3D Spatial Templates</h3>
          <span class="text-[10px] font-black text-indigo-500 dark:text-indigo-400">Swipe / Drag Active</span>
        </div>

        <div id="coverflow-container" class="coverflow-viewport w-full h-58 relative flex items-center justify-center overflow-hidden rounded-[28px] py-4">
          <div id="coverflow-track" class="coverflow-track relative w-full h-full flex items-center justify-center">
            
            <!-- Coverflow Item 1: Modern -->
            <div onclick="selectTemplate('modern')" id="card-tpl-modern" class="coverflow-item absolute w-60 h-48 spatial-glass p-4 rounded-3xl shadow-2xl cursor-pointer border border-white/30 flex flex-col justify-between">
              <div class="w-full h-20 rounded-2xl bg-gradient-to-r from-emerald-500/20 to-teal-500/20 p-2.5 flex flex-col justify-between border border-emerald-500/30">
                <div class="w-1/2 h-2.5 bg-emerald-500 rounded-full"></div>
                <div class="space-y-1">
                  <div class="w-full h-1.5 bg-slate-400/40 rounded-full"></div>
                  <div class="w-3/4 h-1.5 bg-slate-400/40 rounded-full"></div>
                </div>
              </div>
              <div>
                <span class="text-[9px] font-black text-emerald-500 uppercase tracking-widest">Executive</span>
                <p class="font-extrabold text-xs text-slate-900 dark:text-white">Modern Executive</p>
                <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">Balanced & modern layout</p>
              </div>
            </div>

            <!-- Coverflow Item 2: Minimal -->
            <div onclick="selectTemplate('minimal')" id="card-tpl-minimal" class="coverflow-item absolute w-60 h-48 spatial-glass p-4 rounded-3xl shadow-2xl cursor-pointer border border-white/30 flex flex-col justify-between">
              <div class="w-full h-20 rounded-2xl bg-slate-200/50 dark:bg-slate-800/50 p-2.5 flex flex-col justify-between border border-white/20">
                <div class="w-1/3 h-2.5 bg-slate-700 dark:bg-slate-300 rounded-full mx-auto"></div>
                <div class="space-y-1">
                  <div class="w-full h-1.5 bg-slate-400/40 rounded-full"></div>
                  <div class="w-2/3 h-1.5 bg-slate-400/40 rounded-full"></div>
                </div>
              </div>
              <div>
                <span class="text-[9px] font-black text-slate-500 uppercase tracking-widest">Classic</span>
                <p class="font-extrabold text-xs text-slate-900 dark:text-white">Clean Minimalist</p>
                <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">Centered elegant hierarchy</p>
              </div>
            </div>

            <!-- Coverflow Item 3: Tech -->
            <div onclick="selectTemplate('tech')" id="card-tpl-tech" class="coverflow-item absolute w-60 h-48 spatial-glass p-4 rounded-3xl shadow-2xl cursor-pointer border border-white/30 flex flex-col justify-between">
              <div class="w-full h-20 rounded-2xl bg-indigo-500/15 p-2.5 flex flex-col justify-between border border-indigo-500/30">
                <div class="w-2/3 h-2.5 bg-indigo-500 rounded-full"></div>
                <div class="flex gap-1.5">
                  <div class="w-6 h-2 bg-indigo-400/50 rounded-full"></div>
                  <div class="w-6 h-2 bg-indigo-400/50 rounded-full"></div>
                </div>
              </div>
              <div>
                <span class="text-[9px] font-black text-indigo-500 uppercase tracking-widest">Developer</span>
                <p class="font-extrabold text-xs text-slate-900 dark:text-white">Developer Mono</p>
                <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">JetBrains font & tag labels</p>
              </div>
            </div>

            <!-- Coverflow Item 4: Serif -->
            <div onclick="selectTemplate('serif')" id="card-tpl-serif" class="coverflow-item absolute w-60 h-48 spatial-glass p-4 rounded-3xl shadow-2xl cursor-pointer border border-white/30 flex flex-col justify-between">
              <div class="w-full h-20 rounded-2xl bg-amber-500/15 p-2.5 flex flex-col justify-between border border-amber-500/30">
                <div class="w-1/2 h-3 bg-amber-600 rounded-full"></div>
                <div class="space-y-1">
                  <div class="w-full h-1.5 bg-amber-400/30 rounded-full"></div>
                </div>
              </div>
              <div>
                <span class="text-[9px] font-black text-amber-500 uppercase tracking-widest">Editorial</span>
                <p class="font-extrabold text-xs text-slate-900 dark:text-white">Elegant Serif</p>
                <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">Classic editorial style</p>
              </div>
            </div>

          </div>
        </div>
      </div>

      <!-- Dynamic ATS Checklist Spatial Widget -->
      <div class="spatial-glass p-5 rounded-[28px] shadow-xl space-y-3.5 border border-white/20">
        <h3 class="text-xs font-black uppercase tracking-widest text-slate-700 dark:text-slate-300 flex items-center justify-between">
          <span>ATS Optimization Checklist</span>
          <span id="chk-count" class="text-emerald-500 dark:text-emerald-400 font-black text-[10px] bg-emerald-500/10 px-2.5 py-0.5 rounded-full border border-emerald-500/20">0/4 Completed</span>
        </h3>
        <div class="space-y-2 text-xs">
          <div id="chk-item-contact" class="flex items-center justify-between text-slate-700 dark:text-slate-300 p-2 px-3 rounded-xl bg-white/30 dark:bg-slate-850/40">
            <span class="flex items-center gap-2.5 font-semibold"><span>👤</span> Personal & Contact Details</span>
            <span id="chk-icon-contact" class="text-slate-400 font-bold">○</span>
          </div>
          <div id="chk-item-summary" class="flex items-center justify-between text-slate-700 dark:text-slate-300 p-2 px-3 rounded-xl bg-white/30 dark:bg-slate-850/40">
            <span class="flex items-center gap-2.5 font-semibold"><span>📝</span> Professional Summary</span>
            <span id="chk-icon-summary" class="text-slate-400 font-bold">○</span>
          </div>
          <div id="chk-item-exp" class="flex items-center justify-between text-slate-700 dark:text-slate-300 p-2 px-3 rounded-xl bg-white/30 dark:bg-slate-850/40">
            <span class="flex items-center gap-2.5 font-semibold"><span>💼</span> Work History Entries</span>
            <span id="chk-icon-exp" class="text-slate-400 font-bold">○</span>
          </div>
          <div id="chk-item-skills" class="flex items-center justify-between text-slate-700 dark:text-slate-300 p-2 px-3 rounded-xl bg-white/30 dark:bg-slate-850/40">
            <span class="flex items-center gap-2.5 font-semibold"><span>⚡</span> Skills & ATS Keywords</span>
            <span id="chk-icon-skills" class="text-slate-400 font-bold">○</span>
          </div>
        </div>
      </div>

    </div>

    <!-- SCREEN 2: EDITOR WIZARD -->
    <div id="screen-editor" class="space-y-4 hidden">
      
      <div class="flex items-center justify-between pb-1">
        <div>
          <h2 class="text-lg font-black tracking-tight text-slate-900 dark:text-white">Spatial Editor</h2>
          <p class="text-[10px] text-slate-500 dark:text-slate-400">Live synchronization with printable sheet</p>
        </div>
        <button onclick="switchScreen('preview')" class="text-xs font-black px-3.5 py-1.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 tap-active flex items-center gap-1 backdrop-blur-md">
          <span>View Preview</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </button>
      </div>

      <!-- Personal Info Section -->
      <div class="spatial-glass rounded-[28px] p-5 shadow-xl border border-white/20 space-y-3.5">
        <h3 class="text-xs font-black text-emerald-600 dark:text-emerald-400 uppercase tracking-widest flex items-center gap-1.5">
          <span>👤</span> Personal Details
        </h3>
        <div>
          <label for="in-name" class="text-[9px] font-black text-slate-500 dark:text-slate-400 uppercase tracking-wide">Full Name</label>
          <input id="in-name" type="text" placeholder="e.g. Alex Rivera" class="w-full mt-1 bg-white/50 dark:bg-slate-950/40 border border-slate-200 dark:border-white/10 rounded-2xl px-3.5 py-2.5 text-xs font-semibold focus:ring-2 focus:ring-emerald-500/50 outline-none transition backdrop-blur-md" />
        </div>
        <div>
          <label for="in-role" class="text-[9px] font-black text-slate-500 dark:text-slate-400 uppercase tracking-wide">Professional Title</label>
          <input id="in-role" type="text" placeholder="e.g. Senior Mobile Systems Architect" class="w-full mt-1 bg-white/50 dark:bg-slate-950/40 border border-slate-200 dark:border-white/10 rounded-2xl px-3.5 py-2.5 text-xs font-semibold focus:ring-2 focus:ring-emerald-500/50 outline-none transition backdrop-blur-md" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="in-email" class="text-[9px] font-black text-slate-500 dark:text-slate-400 uppercase tracking-wide">Email</label>
            <input id="in-email" type="email" placeholder="alex@domain.com" class="w-full mt-1 bg-white/50 dark:bg-slate-950/40 border border-slate-200 dark:border-white/10 rounded-2xl px-3.5 py-2.5 text-xs focus:ring-2 focus:ring-emerald-500/50 outline-none transition backdrop-blur-md" />
          </div>
          <div>
            <label for="in-phone" class="text-[9px] font-black text-slate-500 dark:text-slate-400 uppercase tracking-wide">Phone</label>
            <input id="in-phone" type="text" placeholder="+1 (555) 019-2831" class="w-full mt-1 bg-white/50 dark:bg-slate-950/40 border border-slate-200 dark:border-white/10 rounded-2xl px-3.5 py-2.5 text-xs focus:ring-2 focus:ring-emerald-500/50 outline-none transition backdrop-blur-md" />
          </div>
        </div>
        <div>
          <label for="in-location" class="text-[9px] font-black text-slate-500 dark:text-slate-400 uppercase tracking-wide">Location & Links</label>
          <input id="in-location" type="text" placeholder="San Francisco, CA • linkedin.com/in/alex" class="w-full mt-1 bg-white/50 dark:bg-slate-950/40 border border-slate-200 dark:border-white/10 rounded-2xl px-3.5 py-2.5 text-xs focus:ring-2 focus:ring-emerald-500/50 outline-none transition backdrop-blur-md" />
        </div>
      </div>

      <!-- Profile Summary Section -->
      <div class="spatial-glass rounded-[28px] p-5 shadow-xl border border-white/20 space-y-3.5">
        <div class="flex items-center justify-between">
          <h3 class="text-xs font-black text-emerald-600 dark:text-emerald-400 uppercase tracking-widest flex items-center gap-1.5">
            <span>📝</span> Profile Summary
          </h3>
          <button id="ai-polish-btn" onclick="aiPolishSummary()" class="text-[10px] font-black bg-gradient-to-r from-emerald-500 to-teal-500 text-white px-3 py-1 rounded-full shadow-md shadow-emerald-500/20 tap-active transition flex items-center gap-1">
            <span id="ai-btn-text">✨ AI Enhance</span>
          </button>
        </div>
        <textarea id="in-summary" rows="3" placeholder="Write a concise overview of your key accomplishments and skills..." class="w-full bg-white/50 dark:bg-slate-950/40 border border-slate-200 dark:border-white/10 rounded-2xl p-3.5 text-xs leading-relaxed focus:ring-2 focus:ring-emerald-500/50 outline-none transition backdrop-blur-md"></textarea>
      </div>

      <!-- Experience Section -->
      <div class="spatial-glass rounded-[28px] p-5 shadow-xl border border-white/20 space-y-3.5">
        <div class="flex items-center justify-between">
          <h3 class="text-xs font-black text-emerald-600 dark:text-emerald-400 uppercase tracking-widest flex items-center gap-1.5">
            <span>💼</span> Work Experience
          </h3>
          <button onclick="addExperience()" class="text-[10px] font-black bg-white/30 dark:bg-slate-800/40 text-slate-700 dark:text-slate-300 border border-white/20 px-3 py-1 rounded-full tap-active flex items-center gap-1">
            <span>+ Add Position</span>
          </button>
        </div>

        <div id="experience-editor-list" class="space-y-3.5"></div>
      </div>

      <!-- Education Section -->
      <div class="spatial-glass rounded-[28px] p-5 shadow-xl border border-white/20 space-y-3.5">
        <div class="flex items-center justify-between">
          <h3 class="text-xs font-black text-emerald-600 dark:text-emerald-400 uppercase tracking-widest flex items-center gap-1.5">
            <span>🎓</span> Education
          </h3>
          <button onclick="addEducation()" class="text-[10px] font-black bg-white/30 dark:bg-slate-800/40 text-slate-700 dark:text-slate-300 border border-white/20 px-3 py-1 rounded-full tap-active flex items-center gap-1">
            <span>+ Add School</span>
          </button>
        </div>

        <div id="education-editor-list" class="space-y-3.5"></div>
      </div>

      <!-- Technical Skills Section -->
      <div class="spatial-glass rounded-[28px] p-5 shadow-xl border border-white/20 space-y-3">
        <h3 class="text-xs font-black text-emerald-600 dark:text-emerald-400 uppercase tracking-widest flex items-center gap-1.5">
          <span>🛠️</span> Technical Skills & Keywords
        </h3>
        <input id="in-skills" type="text" placeholder="Android, TypeScript, Kotlin, React Native, GraphQL" class="w-full bg-white/50 dark:bg-slate-950/40 border border-slate-200 dark:border-white/10 rounded-2xl px-3.5 py-2.5 text-xs font-medium focus:ring-2 focus:ring-emerald-500/50 outline-none transition backdrop-blur-md" />
        <p class="text-[9.5px] text-slate-500 dark:text-slate-400 leading-normal">Separate skills with commas to render as high-impact ATS keyword tags.</p>
      </div>

    </div>

    <!-- SCREEN 3: LIVE A4 PREVIEW & CONTROLS -->
    <div id="screen-preview" class="space-y-4 hidden">
      
      <!-- Preview Controls Dock -->
      <div class="spatial-glass p-3 rounded-[24px] border border-white/20 shadow-xl flex items-center justify-between gap-2">
        <div class="flex items-center space-x-1.5">
          <span class="text-[9px] font-black uppercase tracking-widest text-slate-500 dark:text-slate-400 pl-1">Zoom:</span>
          <button onclick="setZoom(0.85)" class="px-2.5 py-1 rounded-xl bg-white/30 dark:bg-slate-800/40 text-xs font-bold tap-active">85%</button>
          <button onclick="setZoom(1.0)" class="px-2.5 py-1 rounded-xl bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-bold tap-active border border-emerald-500/30">100%</button>
          <button onclick="autoFitScale()" class="px-2.5 py-1 rounded-xl bg-white/30 dark:bg-slate-800/40 text-xs font-bold tap-active">Fit Mobile</button>
        </div>

        <button onclick="handleExportPdf()" class="px-3.5 py-1.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 text-white font-black text-xs shadow-lg shadow-emerald-500/20 tap-active flex items-center gap-1 border border-white/20">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
          <span>Print / PDF</span>
        </button>
      </div>

      <!-- Printable A4 View Container embedded in spatial viewport -->
      <div class="overflow-x-auto pb-6 no-scrollbar flex justify-center items-start pt-2">
        <div id="preview-zoom-wrapper" class="origin-top transition-transform duration-300">
          <div id="printable-resume" class="a4-container rounded-[32px] p-10 text-slate-900 font-sans flex flex-col justify-between relative shadow-2xl">
            <!-- Dynamic CV Content Injected via JS -->
          </div>
        </div>
      </div>

    </div>

  </main>

  <!-- TOAST NOTIFICATION -->
  <div id="toast" class="no-print fixed bottom-24 left-1/2 -translate-x-1/2 z-50 spatial-glass text-slate-900 dark:text-white text-xs font-black px-5 py-3 rounded-full shadow-2xl hidden toast-animate flex items-center gap-2 border border-white/30 backdrop-blur-2xl">
    <span id="toast-icon">✨</span>
    <span id="toast-msg">Action updated</span>
  </div>

  <!-- FLOATING SPATIAL BOTTOM NAVIGATION BAR -->
  <nav class="no-print fixed bottom-4 left-1/2 -translate-x-1/2 z-50 w-[92%] max-w-md spatial-glass rounded-full px-6 py-2.5 flex items-center justify-around shadow-2xl border border-white/30 dark:border-white/15">
    
    <button onclick="switchScreen('dashboard')" id="nav-dashboard" class="flex flex-col items-center gap-1 text-emerald-500 dark:text-emerald-400 font-extrabold transition tap-active">
      <svg class="w-5.5 h-5.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
      <span class="text-[9px] tracking-wide font-black uppercase">Home</span>
    </button>

    <button onclick="switchScreen('editor')" id="nav-editor" class="flex flex-col items-center gap-1 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 font-semibold transition tap-active">
      <svg class="w-5.5 h-5.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
      <span class="text-[9px] tracking-wide font-black uppercase">Editor</span>
    </button>

    <button onclick="switchScreen('preview')" id="nav-preview" class="flex flex-col items-center gap-1 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 font-semibold transition tap-active">
      <svg class="w-5.5 h-5.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
      <span class="text-[9px] tracking-wide font-black uppercase">Preview</span>
    </button>

  </nav>

  <!-- APPLICATION LOGIC & SPATIAL COVERFLOW ENGINE -->
  <script>
    const STATE_KEY = 'tapuniverse_resumeforge_v3';

    let appState = {
      personal: {
        name: 'Alex Rivera',
        role: 'Senior Mobile Systems Architect',
        email: 'alex.rivera@forge.io',
        phone: '+1 (555) 019-2831',
        location: 'San Francisco, CA • linkedin.com/in/alexrivera'
      },
      summary: 'Results-driven Mobile Systems Architect with 7+ years of experience designing high-throughput offline engines, cross-platform Android runtime optimizations, and automated deployment pipelines.',
      experiences: [
        {
          id: 1,
          role: 'Lead Systems Architect',
          company: 'Vanguard Core Systems',
          dates: '2023 - Present',
          desc: 'Pioneered zero-latency mobile synchronizer reducing memory footprints by 42% across 300K monthly active mobile sessions.'
        },
        {
          id: 2,
          role: 'Senior Mobile Engineer',
          company: 'Apex Cloud Mobile',
          dates: '2020 - 2023',
          desc: 'Engineered cross-platform Android native integrations, improving launch rendering times by 2.4x for high-load enterprise apps.'
        }
      ],
      education: [
        {
          id: 1,
          degree: 'B.S. Computer Science & Software Engineering',
          school: 'University of California, Berkeley',
          year: '2016 - 2020'
        }
      ],
      skills: 'Android Architecture, TypeScript, Kotlin, Capacitor, Vercel CI/CD, SQLite, Tailwind CSS, Jetpack Compose, GraphQL',
      accentColor: '#059669',
      accentName: 'Emerald Green',
      template: 'modern'
    };

    let toastTimer = null;
    function showToast(msg, icon = '✨') {
      const toast = document.getElementById('toast');
      const msgEl = document.getElementById('toast-msg');
      const iconEl = document.getElementById('toast-icon');
      if (!toast || !msgEl) return;

      msgEl.innerText = msg;
      if (iconEl) iconEl.innerText = icon;
      toast.classList.remove('hidden');

      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toast.classList.add('hidden');
      }, 2200);
    }

    function saveState() {
      localStorage.setItem(STATE_KEY, JSON.stringify(appState));
      updateDashboardData();
      renderPreview();
    }

    function loadState() {
      const saved = localStorage.getItem(STATE_KEY);
      if (saved) {
        try {
          appState = { ...appState, ...JSON.parse(saved) };
        } catch (e) { console.error('Failed to parse saved state', e); }
      }
      syncInputsFromState();
      updateDashboardData();
      renderPreview();
    }

    function syncInputsFromState() {
      const setVal = (id, val) => {
        const el = document.getElementById(id);
        if (el) el.value = val || '';
      };

      setVal('in-name', appState.personal.name);
      setVal('in-role', appState.personal.role);
      setVal('in-email', appState.personal.email);
      setVal('in-phone', appState.personal.phone);
      setVal('in-location', appState.personal.location);
      setVal('in-summary', appState.summary);
      setVal('in-skills', appState.skills);
      
      renderExperienceEditors();
      renderEducationEditors();
      selectTemplate(appState.template || 'modern', false);
      if (appState.accentName) {
        const label = document.getElementById('current-color-label');
        if (label) label.innerText = appState.accentName;
      }
    }

    const bindField = (id, keyPath) => {
      const el = document.getElementById(id);
      if (!el) return;
      el.addEventListener('input', (e) => {
        if (keyPath.startsWith('personal.')) {
          const subKey = keyPath.split('.')[1];
          appState.personal[subKey] = e.target.value;
        } else {
          appState[keyPath] = e.target.value;
        }
        saveState();
      });
    };

    bindField('in-name', 'personal.name');
    bindField('in-role', 'personal.role');
    bindField('in-email', 'personal.email');
    bindField('in-phone', 'personal.phone');
    bindField('in-location', 'personal.location');
    bindField('in-summary', 'summary');
    bindField('in-skills', 'skills');

    function renderExperienceEditors() {
      const container = document.getElementById('experience-editor-list');
      if (!container) return;
      container.innerHTML = appState.experiences.map((exp, idx) => `
        <div class="p-4 rounded-2xl bg-white/40 dark:bg-slate-950/40 border border-slate-200/80 dark:border-white/10 space-y-3.5 relative backdrop-blur-md">
          <div class="flex items-center justify-between">
            <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Position #${idx + 1}</span>
            <button onclick="removeExperience(${exp.id})" class="text-[10px] font-bold text-red-500 hover:text-red-600 tap-active">
              Remove
            </button>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="text-[8px] font-black uppercase text-slate-500 tracking-wider">Role Title</label>
              <input type="text" value="${exp.role || ''}" placeholder="Role Title" oninput="updateExp(${exp.id}, 'role', this.value)" class="w-full mt-1 bg-white/60 dark:bg-slate-900/60 border border-slate-200 dark:border-white/10 rounded-xl p-2 px-3 text-xs font-semibold outline-none focus:ring-1 focus:ring-emerald-500 transition" />
            </div>
            <div>
              <label class="text-[8px] font-black uppercase text-slate-500 tracking-wider">Company</label>
              <input type="text" value="${exp.company || ''}" placeholder="Company" oninput="updateExp(${exp.id}, 'company', this.value)" class="w-full mt-1 bg-white/60 dark:bg-slate-900/60 border border-slate-200 dark:border-white/10 rounded-xl p-2 px-3 text-xs font-semibold outline-none focus:ring-1 focus:ring-emerald-500 transition" />
            </div>
          </div>
          <div>
            <label class="text-[8px] font-black uppercase text-slate-500 tracking-wider">Dates Active</label>
            <input type="text" value="${exp.dates || ''}" placeholder="Dates e.g., 2022 - Present" oninput="updateExp(${exp.id}, 'dates', this.value)" class="w-full mt-1 bg-white/60 dark:bg-slate-900/60 border border-slate-200 dark:border-white/10 rounded-xl p-2 px-3 text-xs outline-none focus:ring-1 focus:ring-emerald-500 transition" />
          </div>
          <div>
            <label class="text-[8px] font-black uppercase text-slate-500 tracking-wider">Key Metrics & Responsibilities</label>
            <textarea rows="2" placeholder="Key responsibilities & metric achievements..." oninput="updateExp(${exp.id}, 'desc', this.value)" class="w-full mt-1 bg-white/60 dark:bg-slate-900/60 border border-slate-200 dark:border-white/10 rounded-xl p-2 px-3 text-xs leading-relaxed outline-none focus:ring-1 focus:ring-emerald-500 transition">${exp.desc || ''}</textarea>
          </div>
        </div>
      `).join('');
    }

    function addExperience() {
      appState.experiences.push({
        id: Date.now(),
        role: 'Senior Software Engineer',
        company: 'Innovate Tech',
        dates: '2021 - 2023',
        desc: 'Built scalable client runtime architectures and optimized cross-platform deployment modules.'
      });
      renderExperienceEditors();
      saveState();
      showToast('New position added', '💼');
    }

    function removeExperience(id) {
      appState.experiences = appState.experiences.filter(e => e.id !== id);
      renderExperienceEditors();
      saveState();
      showToast('Position removed', '🗑️');
    }

    function updateExp(id, field, value) {
      const exp = appState.experiences.find(e => e.id === id);
      if (exp) {
        exp[field] = value;
        saveState();
      }
    }

    function renderEducationEditors() {
      const container = document.getElementById('education-editor-list');
      if (!container) return;
      container.innerHTML = appState.education.map((edu, idx) => `
        <div class="p-4 rounded-2xl bg-white/40 dark:bg-slate-950/40 border border-slate-200/80 dark:border-white/10 space-y-3.5 relative backdrop-blur-md">
          <div class="flex items-center justify-between">
            <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Degree #${idx + 1}</span>
            <button onclick="removeEducation(${edu.id})" class="text-[10px] font-bold text-red-500 hover:text-red-600 tap-active">
              Remove
            </button>
          </div>
          <div>
            <label class="text-[8px] font-black uppercase text-slate-500 tracking-wider">Degree Title</label>
            <input type="text" value="${edu.degree || ''}" placeholder="Degree Title" oninput="updateEdu(${edu.id}, 'degree', this.value)" class="w-full mt-1 bg-white/60 dark:bg-slate-900/60 border border-slate-200 dark:border-white/10 rounded-xl p-2 px-3 text-xs font-semibold outline-none focus:ring-1 focus:ring-emerald-500 transition" />
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="text-[8px] font-black uppercase text-slate-500 tracking-wider">University / Institute</label>
              <input type="text" value="${edu.school || ''}" placeholder="University / Institute" oninput="updateEdu(${edu.id}, 'school', this.value)" class="w-full mt-1 bg-white/60 dark:bg-slate-900/60 border border-slate-200 dark:border-white/10 rounded-xl p-2 px-3 text-xs outline-none focus:ring-1 focus:ring-emerald-500 transition" />
            </div>
            <div>
              <label class="text-[8px] font-black uppercase text-slate-500 tracking-wider">Year</label>
              <input type="text" value="${edu.year || ''}" placeholder="Graduation Year" oninput="updateEdu(${edu.id}, 'year', this.value)" class="w-full mt-1 bg-white/60 dark:bg-slate-900/60 border border-slate-200 dark:border-white/10 rounded-xl p-2 px-3 text-xs outline-none focus:ring-1 focus:ring-emerald-500 transition" />
            </div>
          </div>
        </div>
      `).join('');
    }

    function addEducation() {
      appState.education.push({
        id: Date.now(),
        degree: 'M.S. Software Architecture',
        school: 'Stanford University',
        year: '2020 - 2022'
      });
      renderEducationEditors();
      saveState();
      showToast('Education entry added', '🎓');
    }

    function removeEducation(id) {
      appState.education = appState.education.filter(e => e.id !== id);
      renderEducationEditors();
      saveState();
      showToast('Education entry removed', '🗑️');
    }

    function updateEdu(id, field, value) {
      const edu = appState.education.find(e => e.id === id);
      if (edu) {
        edu[field] = value;
        saveState();
      }
    }

    function updateDashboardData() {
      const nameEl = document.getElementById('dash-name');
      const roleEl = document.getElementById('dash-role');
      if (nameEl) nameEl.innerText = appState.personal.name || 'Your Name';
      if (roleEl) roleEl.innerText = appState.personal.role || 'Your Professional Title';

      const chkContact = !!(appState.personal.name && appState.personal.email && appState.personal.phone);
      const chkSummary = !!(appState.summary && appState.summary.length > 25);
      const chkExp = !!(appState.experiences && appState.experiences.length > 0);
      const chkSkills = !!(appState.skills && appState.skills.split(',').filter(Boolean).length >= 3);

      let score = 0;
      if (chkContact) score += 25;
      if (chkSummary) score += 25;
      if (chkExp) score += 25;
      if (chkSkills) score += 25;

      const circle = document.getElementById('progress-circle');
      if (circle) {
        circle.setAttribute('stroke-dasharray', `${score}, 100`);
      }

      const scoreEl = document.getElementById('dash-score');
      if (scoreEl) scoreEl.innerText = `${score}%`;

      const gradeText = document.getElementById('dash-grade-text');
      if (gradeText) {
        if (score >= 100) {
          gradeText.innerText = 'Excellent Match (Grade A)';
          gradeText.className = 'text-emerald-500 dark:text-emerald-400 font-bold';
        } else if (score >= 75) {
          gradeText.innerText = 'Good Match (Grade B)';
          gradeText.className = 'text-teal-500 dark:text-teal-400 font-bold';
        } else if (score >= 50) {
          gradeText.innerText = 'Moderate Match (Grade C)';
          gradeText.className = 'text-amber-500 dark:text-amber-400 font-bold';
        } else {
          gradeText.innerText = 'Incomplete CV';
          gradeText.className = 'text-red-500 dark:text-red-400 font-bold';
        }
      }

      const updateCheckItem = (id, isDone) => {
        const icon = document.getElementById(`chk-icon-${id}`);
        if (icon) {
          icon.innerText = isDone ? '✓' : '○';
          icon.className = isDone ? 'text-emerald-500 font-black text-sm' : 'text-slate-400 font-bold';
        }
      };

      updateCheckItem('contact', chkContact);
      updateCheckItem('summary', chkSummary);
      updateCheckItem('exp', chkExp);
      updateCheckItem('skills', chkSkills);

      const items = [chkContact, chkSummary, chkExp, chkSkills];
      const doneCount = items.filter(Boolean).length;
      const countEl = document.getElementById('chk-count');
      if (countEl) countEl.innerText = `${doneCount}/4 Completed`;
    }

    function switchScreen(screen) {
      ['dashboard', 'editor', 'preview'].forEach(s => {
        const scrEl = document.getElementById(`screen-${s}`);
        const navEl = document.getElementById(`nav-${s}`);
        if (scrEl) scrEl.classList.add('hidden');
        if (navEl) {
          navEl.classList.remove('text-emerald-500', 'dark:text-emerald-400', 'font-extrabold');
          navEl.classList.add('text-slate-400', 'font-medium');
        }
      });

      const activeScreen = document.getElementById(`screen-${screen}`);
      const activeNav = document.getElementById(`nav-${screen}`);
      if (activeScreen) activeScreen.classList.remove('hidden');
      if (activeNav) {
        activeNav.classList.add('text-emerald-500', 'dark:text-emerald-400', 'font-extrabold');
        activeNav.classList.remove('text-slate-400', 'font-medium');
      }

      if (screen === 'preview') {
        renderPreview();
        autoFitScale();
      }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function setAccent(hexColor, name = '') {
      appState.accentColor = hexColor;
      if (name) appState.accentName = name;
      const label = document.getElementById('current-color-label');
      if (label) label.innerText = appState.accentName || 'Custom Color';
      saveState();
      showToast(`Color: ${appState.accentName}`, '🎨');
    }

    // 3D Coverflow Perspective Logic
    const templatesList = ['modern', 'minimal', 'tech', 'serif'];
    
    function updateCoverflowLayout(selectedId) {
      const activeIdx = templatesList.indexOf(selectedId);
      templatesList.forEach((t, idx) => {
        const card = document.getElementById(`card-tpl-${t}`);
        if (!card) return;

        const offset = idx - activeIdx;
        const absOffset = Math.abs(offset);
        
        let translateX = offset * 125; // spatial spacing horizontal
        let translateZ = -absOffset * 150; // 3D depth shift
        let rotateY = offset * -32; // perspective angle tilt
        let opacity = 1 - absOffset * 0.32;
        let scale = 1 - absOffset * 0.15;

        if (offset === 0) {
          card.style.transform = `translateX(0px) translateZ(80px) rotateY(0deg) scale(1.08)`;
          card.style.opacity = '1';
          card.style.zIndex = '30';
          card.classList.add('ring-2', 'ring-emerald-500', 'ring-offset-4', 'ring-offset-transparent');
        } else {
          card.style.transform = `translateX(${translateX}px) translateZ(${translateZ}px) rotateY(${rotateY}deg) scale(${scale})`;
          card.style.opacity = `${opacity}`;
          card.style.zIndex = `${20 - absOffset}`;
          card.classList.remove('ring-2', 'ring-emerald-500', 'ring-offset-4', 'ring-offset-transparent');
        }
      });
    }

    function selectTemplate(templateId, shouldSave = true) {
      appState.template = templateId;
      updateCoverflowLayout(templateId);

      if (shouldSave) {
        saveState();
        showToast(`Template updated`, '📄');
      }
    }

    // Touch & Mouse Drag Physics for 3D Coverflow
    let isDragging = false;
    let startX = 0;
    let currentDragOffset = 0;
    const coverflowViewport = document.getElementById('coverflow-container');

    if (coverflowViewport) {
      // Touch Support
      coverflowViewport.addEventListener('touchstart', e => {
        isDragging = true;
        startX = e.touches[0].clientX;
        currentDragOffset = 0;
      }, { passive: true });

      coverflowViewport.addEventListener('touchmove', e => {
        if (!isDragging) return;
        currentDragOffset = e.touches[0].clientX - startX;
      }, { passive: true });

      coverflowViewport.addEventListener('touchend', () => {
        if (!isDragging) return;
        isDragging = false;
        handleDragRelease();
      }, { passive: true });

      // Mouse Support for Desktop
      coverflowViewport.addEventListener('mousedown', e => {
        isDragging = true;
        startX = e.clientX;
        currentDragOffset = 0;
      });

      window.addEventListener('mousemove', e => {
        if (!isDragging) return;
        currentDragOffset = e.clientX - startX;
      });

      window.addEventListener('mouseup', () => {
        if (!isDragging) return;
        isDragging = false;
        handleDragRelease();
      });
    }

    function handleDragRelease() {
      if (Math.abs(currentDragOffset) > 50) {
        const currentIdx = templatesList.indexOf(appState.template || 'modern');
        if (currentDragOffset < 0 && currentIdx < templatesList.length - 1) {
          selectTemplate(templatesList[currentIdx + 1]);
        } else if (currentDragOffset > 0 && currentIdx > 0) {
          selectTemplate(templatesList[currentIdx - 1]);
        }
      }
    }

    function renderPreview() {
      const container = document.getElementById('printable-resume');
      if (!container) return;

      const color = appState.accentColor || '#059669';
      const fontClass = appState.template === 'serif' ? 'tpl-font-serif' : (appState.template === 'tech' ? 'tpl-font-mono' : 'tpl-font-sans');
      const skillChips = (appState.skills || '').split(',').map(s => s.trim()).filter(Boolean);

      let headerHTML = '';

      if (appState.template === 'modern') {
        headerHTML = `
          <div class="border-b-2 pb-5 mb-6" style="border-color: ${color}">
            <h1 class="text-3xl font-black tracking-tight text-slate-900 uppercase">${appState.personal.name || 'YOUR NAME'}</h1>
            <p class="text-xs font-extrabold uppercase tracking-widest mt-1.5" style="color: ${color}">${appState.personal.role || ''}</p>
            <p class="text-[10px] text-slate-500 mt-2 font-medium">${appState.personal.email || ''}  •  ${appState.personal.phone || ''}  •  ${appState.personal.location || ''}</p>
          </div>
        `;
      } else if (appState.template === 'minimal') {
        headerHTML = `
          <div class="text-center border-b pb-5 mb-6 border-slate-200">
            <h1 class="text-3xl font-black text-slate-900 tracking-tight">${appState.personal.name || 'YOUR NAME'}</h1>
            <p class="text-xs font-bold text-slate-650 uppercase tracking-widest mt-1" style="color: ${color}">${appState.personal.role || ''}</p>
            <p class="text-[10px] text-slate-500 mt-2">${appState.personal.email || ''} | ${appState.personal.phone || ''} | ${appState.personal.location || ''}</p>
          </div>
        `;
      } else if (appState.template === 'tech') {
        headerHTML = `
          <div class="p-5 rounded-2xl mb-6" style="background-color: ${color}10; border-left: 4px solid ${color}">
            <h1 class="text-2xl font-bold text-slate-900 font-mono">&lt;${appState.personal.name || 'YOUR NAME'}&gt;</h1>
            <p class="text-xs font-black uppercase tracking-wider mt-1" style="color: ${color}">${appState.personal.role || ''}</p>
            <p class="text-[10px] text-slate-600 font-mono mt-2">${appState.personal.email || ''} // ${appState.personal.phone || ''} // ${appState.personal.location || ''}</p>
          </div>
        `;
      } else if (appState.template === 'serif') {
        headerHTML = `
          <div class="border-b pb-4 mb-6 border-slate-300">
            <h1 class="text-3xl font-bold text-slate-900 font-serif italic tracking-tight">${appState.personal.name || 'YOUR NAME'}</h1>
            <p class="text-xs font-black uppercase tracking-widest mt-1.5" style="color: ${color}">${appState.personal.role || ''}</p>
            <p class="text-[10px] text-slate-600 mt-2 italic font-medium">${appState.personal.email || ''}  —  ${appState.personal.phone || ''}  —  ${appState.personal.location || ''}</p>
          </div>
        `;
      }

      container.className = `a4-container rounded-[32px] p-10 text-slate-900 flex flex-col justify-between relative ${fontClass}`;

      container.innerHTML = `
        <div>
          ${headerHTML}

          <div class="mb-6">
            <h2 class="text-xs font-black uppercase tracking-widest mb-2 flex items-center gap-2" style="color: ${color}">
              <span>PROFESSIONAL SUMMARY</span>
              <span class="flex-1 h-[1px] bg-slate-200"></span>
            </h2>
            <p class="text-[10.5px] text-slate-700 leading-relaxed font-normal">${appState.summary || ''}</p>
          </div>

          <div class="mb-6">
            <h2 class="text-xs font-black uppercase tracking-widest mb-3.5 flex items-center gap-2" style="color: ${color}">
              <span>WORK EXPERIENCE</span>
              <span class="flex-1 h-[1px] bg-slate-200"></span>
            </h2>
            <div class="space-y-4">
              ${(appState.experiences || []).map(exp => `
                <div>
                  <div class="flex justify-between items-baseline">
                    <span class="text-[11px] font-bold text-slate-900">${exp.role || ''}</span>
                    <span class="text-[9.5px] font-semibold text-slate-500">${exp.dates || ''}</span>
                  </div>
                  <div class="text-[10px] font-extrabold" style="color: ${color}">${exp.company || ''}</div>
                  <p class="text-[10px] text-slate-600 mt-1.5 leading-relaxed font-normal">${exp.desc || ''}</p>
                </div>
              `).join('')}
            </div>
          </div>

          <div class="mb-6">
            <h2 class="text-xs font-black uppercase tracking-widest mb-3 flex items-center gap-2" style="color: ${color}">
              <span>EDUCATION</span>
              <span class="flex-1 h-[1px] bg-slate-200"></span>
            </h2>
            <div class="space-y-2.5">
              ${(appState.education || []).map(edu => `
                <div class="flex justify-between items-baseline">
                  <div>
                    <span class="text-[10.5px] font-bold text-slate-900">${edu.degree || ''}</span>
                    <p class="text-[9.5px] text-slate-650">${edu.school || ''}</p>
                  </div>
                  <span class="text-[9.5px] text-slate-500 font-semibold">${edu.year || ''}</span>
                </div>
              `).join('')}
            </div>
          </div>
        </div>

        <div class="pt-4 border-t border-slate-150">
          <h2 class="text-xs font-black uppercase tracking-widest mb-2.5" style="color: ${color}">SKILLS & ATS KEYWORDS</h2>
          <div class="flex flex-wrap gap-1.5">
            ${skillChips.map(chip => `
              <span class="px-2.5 py-1 rounded-md text-[9px] font-extrabold tracking-wide uppercase" style="background-color: ${color}15; color: ${color}">
                ${chip}
              </span>
            `).join('')}
          </div>
        </div>
      `;
    }

    function setZoom(scale) {
      const wrapper = document.getElementById('preview-zoom-wrapper');
      if (wrapper) {
        wrapper.style.transform = `scale(${scale})`;
      }
    }

    function autoFitScale() {
      const screenWidth = window.innerWidth - 32;
      const a4Width = 794;
      const computedScale = Math.min(1.0, Math.max(0.38, screenWidth / a4Width));
      setZoom(computedScale);
    }

    function aiPolishSummary() {
      const btn = document.getElementById('ai-polish-btn');
      const btnText = document.getElementById('ai-btn-text');
      if (btn && btnText) {
        btnText.innerText = "⏳ Enhancing...";
        btn.disabled = true;
      }

      setTimeout(() => {
        const polished = "Accomplished Mobile Systems Architect with extensive expertise in cross-platform Android runtime optimization, offline-first sync engines, and automated deployment pipelines that boost application metrics by up to 45%.";
        appState.summary = polished;
        const el = document.getElementById('in-summary');
        if (el) el.value = polished;
        saveState();
        showToast('Summary AI polished!', '✨');
        
        if (btn && btnText) {
          btnText.innerText = "✨ AI Enhance";
          btn.disabled = false;
        }
      }, 750);
    }

    function loadSampleData() {
      appState = {
        personal: {
          name: 'Alex Rivera',
          role: 'Senior Mobile Systems Architect',
          email: 'alex.rivera@forge.io',
          phone: '+1 (555) 019-2831',
          location: 'San Francisco, CA • linkedin.com/in/alexrivera'
        },
        summary: 'Results-driven Mobile Systems Architect with 7+ years of experience designing high-throughput offline engines, cross-platform Android runtime optimizations, and automated deployment pipelines.',
        experiences: [
          {
            id: 1,
            role: 'Lead Systems Architect',
            company: 'Vanguard Core Systems',
            dates: '2023 - Present',
            desc: 'Pioneered zero-latency mobile synchronizer reducing memory footprints by 42% across 300K monthly active mobile sessions.'
          },
          {
            id: 2,
            role: 'Senior Mobile Engineer',
            company: 'Apex Cloud Mobile',
            dates: '2020 - 2023',
            desc: 'Engineered cross-platform Android native integrations, improving launch rendering times by 2.4x for high-load enterprise apps.'
          }
        ],
        education: [
          {
            id: 1,
            degree: 'B.S. Computer Science & Software Engineering',
            school: 'University of California, Berkeley',
            year: '2016 - 2020'
          }
        ],
        skills: 'Android Architecture, TypeScript, Kotlin, Capacitor, Vercel CI/CD, SQLite, Tailwind CSS, Jetpack Compose, GraphQL',
        accentColor: '#059669',
        accentName: 'Emerald Green',
        template: 'modern'
      };
      syncInputsFromState();
      saveState();
      showToast('Sample data loaded', '⚡');
    }

    function toggleTheme() {
      const isDark = document.documentElement.classList.toggle('dark');
      const sunIcon = document.getElementById('theme-icon-sun');
      const moonIcon = document.getElementById('theme-icon-moon');
      if (sunIcon) sunIcon.classList.toggle('hidden', !isDark);
      if (moonIcon) moonIcon.classList.toggle('hidden', isDark);
      localStorage.setItem('tapuniverse_theme', isDark ? 'dark' : 'light');
    }

    function handleExportPdf() {
      window.print();
    }

    window.addEventListener('resize', () => {
      const previewScr = document.getElementById('screen-preview');
      if (previewScr && !previewScr.classList.contains('hidden')) {
        autoFitScale();
      }
    });

    window.addEventListener('DOMContentLoaded', () => {
      if (localStorage.getItem('tapuniverse_theme') === 'light') {
        document.documentElement.classList.remove('dark');
        const sunIcon = document.getElementById('theme-icon-sun');
        const moonIcon = document.getElementById('theme-icon-moon');
        if (sunIcon) sunIcon.classList.add('hidden');
        if (moonIcon) moonIcon.classList.remove('hidden');
      }
      loadState();
    });
  </script>

</body>
</html>