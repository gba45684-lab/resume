<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ResumeForge Live Studio</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
    @media print {
      body * { visibility: hidden; }
      #resume-preview, #resume-preview * { visibility: visible; }
      #resume-preview { position: absolute; left: 0; top: 0; width: 100%; box-shadow: none; }
      .no-print { display: none !important; }
    }
  </style>
</head>
<body class="bg-[#0b0f19] text-slate-100 min-h-screen">

  <!-- Navigation Bar -->
  <header class="no-print border-b border-slate-800 bg-[#0f172a]/80 backdrop-blur sticky top-0 z-50 px-4 py-3 flex items-center justify-between">
    <div class="flex items-center space-x-3">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-indigo-500 to-violet-500 flex items-center justify-center shadow-lg shadow-indigo-500/30">
        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
      </div>
      <div>
        <h1 class="font-extrabold text-sm tracking-wider uppercase">ResumeForge</h1>
        <p class="text-[10px] text-slate-400">Live Over-The-Air Studio</p>
      </div>
    </div>
    <div class="flex items-center space-x-2">
      <span id="ats-badge" class="px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
        ATS: 85%
      </span>
      <button onclick="window.print()" class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-500 rounded-lg text-xs font-bold shadow-md shadow-indigo-600/30 transition">
        Export PDF
      </button>
    </div>
  </header>

  <!-- Main Container -->
  <main class="max-w-6xl mx-auto p-4 grid grid-cols-1 lg:grid-cols-2 gap-6">
    
    <!-- Editor Form -->
    <section class="no-print space-y-4">
      <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-4 space-y-3">
        <h2 class="text-xs font-bold tracking-wider text-indigo-400 uppercase">Profile Details</h2>
        <div>
          <label class="text-[11px] text-slate-400">Full Name</label>
          <input id="input-name" type="text" value="Alex Rivera" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm focus:border-indigo-500 outline-none transition" />
        </div>
        <div>
          <label class="text-[11px] text-slate-400">Role / Title</label>
          <input id="input-role" type="text" value="Senior Mobile Systems Architect" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm focus:border-indigo-500 outline-none transition" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="text-[11px] text-slate-400">Email</label>
            <input id="input-email" type="email" value="alex.rivera@forge.io" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm focus:border-indigo-500 outline-none transition" />
          </div>
          <div>
            <label class="text-[11px] text-slate-400">Phone</label>
            <input id="input-phone" type="text" value="+1 (555) 019-2831" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm focus:border-indigo-500 outline-none transition" />
          </div>
        </div>
      </div>

      <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-4 space-y-3">
        <div class="flex justify-between items-center">
          <h2 class="text-xs font-bold tracking-wider text-indigo-400 uppercase">Executive Summary</h2>
          <button onclick="polishWithAI()" class="text-xs text-indigo-400 hover:text-indigo-300 flex items-center space-x-1 font-semibold">
            <span>✨ Polish AI</span>
          </button>
        </div>
        <textarea id="input-summary" rows="3" class="w-full bg-slate-950 border border-slate-800 rounded-lg p-3 text-xs focus:border-indigo-500 outline-none transition leading-relaxed">High-impact engineer specialized in cross-platform native rendering engines, sub-millisecond data sync, and resilient mobile architectures.</textarea>
      </div>

      <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-4 space-y-3">
        <h2 class="text-xs font-bold tracking-wider text-indigo-400 uppercase">Skills (Comma Separated)</h2>
        <input id="input-skills" type="text" value="Flutter, Dart, Rust, WebAssembly, CI/CD, Docker, SQLite" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm focus:border-indigo-500 outline-none transition" />
      </div>
    </section>

    <!-- Live A4 Resume Preview -->
    <section class="flex justify-center">
      <div id="resume-preview" class="w-full max-w-[500px] aspect-[1/1.414] bg-white text-slate-900 rounded-xl shadow-2xl p-6 flex flex-col justify-between text-left">
        <div>
          <h1 id="preview-name" class="text-2xl font-black text-indigo-950 tracking-tight">ALEX RIVERA</h1>
          <p id="preview-role" class="text-xs font-bold text-indigo-600 tracking-wide uppercase mt-0.5">Senior Mobile Systems Architect</p>
          <p id="preview-contact" class="text-[10px] text-slate-500 mt-1">alex.rivera@forge.io  •  +1 (555) 019-2831</p>
          
          <hr class="my-3 border-slate-200" />
          
          <h2 class="text-[11px] font-bold text-indigo-900 uppercase tracking-wider">Executive Summary</h2>
          <p id="preview-summary" class="text-[10.5px] text-slate-700 mt-1 leading-relaxed">High-impact engineer specialized in cross-platform native rendering engines, sub-millisecond data sync, and resilient mobile architectures.</p>

          <h2 class="text-[11px] font-bold text-indigo-900 uppercase tracking-wider mt-4">Experience Highlights</h2>
          <div class="mt-1 space-y-2">
            <div>
              <div class="flex justify-between text-[10px] font-bold text-slate-800">
                <span>Vanguard Tech Core</span>
                <span class="text-slate-500">2023 - Present</span>
              </div>
              <p class="text-[9.5px] text-slate-600 mt-0.5 leading-normal">Engineered zero-latency mobile rendering pipeline reducing frame drop rates by 42%.</p>
            </div>
            <div>
              <div class="flex justify-between text-[10px] font-bold text-slate-800">
                <span>Apex Solutions</span>
                <span class="text-slate-500">2021 - 2023</span>
              </div>
              <p class="text-[9.5px] text-slate-600 mt-0.5 leading-normal">Scaled offline-first synchronization infrastructure serving 200,000+ active users.</p>
            </div>
          </div>
        </div>

        <div>
          <h2 class="text-[11px] font-bold text-indigo-900 uppercase tracking-wider">Core Capabilities</h2>
          <div id="preview-skills" class="flex flex-wrap gap-1.5 mt-1.5">
            <!-- Badges render here -->
          </div>
        </div>
      </div>
    </section>

  </main>

  <script>
    const bind = (id, target, callback) => {
      document.getElementById(id).addEventListener('input', (e) => {
        document.getElementById(target).innerText = e.target.value;
        if (callback) callback();
      });
    };

    bind('input-name', 'preview-name');
    bind('input-role', 'preview-role');
    bind('input-summary', 'preview-summary');

    const updateContact = () => {
      const email = document.getElementById('input-email').value;
      const phone = document.getElementById('input-phone').value;
      document.getElementById('preview-contact').innerText = `${email}  •  ${phone}`;
    };

    document.getElementById('input-email').addEventListener('input', updateContact);
    document.getElementById('input-phone').addEventListener('input', updateContact);

    const updateSkills = () => {
      const skills = document.getElementById('input-skills').value.split(',');
      const container = document.getElementById('preview-skills');
      container.innerHTML = skills.map(s => `<span class="bg-indigo-50 text-indigo-700 px-2 py-0.5 rounded text-[9px] font-semibold">${s.trim()}</span>`).join('');
    };

    document.getElementById('input-skills').addEventListener('input', updateSkills);
    updateSkills();

    function polishWithAI() {
      const field = document.getElementById('input-summary');
      field.value = "Engineered enterprise mobile architectures that elevated ATS benchmarks by 35% while cutting client compute latency across cross-functional pipelines.";
      document.getElementById('preview-summary').innerText = field.value;
      document.getElementById('ats-badge').innerText = "ATS: 98%";
    }
  </script>
</body>
</html>
